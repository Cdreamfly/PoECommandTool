<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Rtl8239Verify</AssemblyName>
    <RootNamespace>Rtl8239Verify</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SerialLowLevelTests.cs" />
    <Compile Include="SerialSessionTests.cs" />
    <Compile Include="SerialPollingTests.cs" />
    <Compile Include="ChartTests.cs" />
    <Compile Include="ConsoleEndToEndTests.cs" />
    <Compile Include="SerialHardeningTests.cs" />
    <Compile Include="ReadLoopRaceTests.cs" />
    <Compile Include="ResponseAndPortTests.cs" />
    <Compile Include="ByteOrderTests.cs" />
    <Compile Include="DescribeSeriesTests.cs" />
    <Compile Include="LivePipelineTests.cs" />
    <Compile Include="SeriesFeatureTests.cs" />
    <Compile Include="DownloadPlanTests.cs" />
    <Compile Include="FieldRangeTests.cs" />
    <Compile Include="DeviceInfoTests.cs" />
    <Compile Include="CommandKeyTests.cs" />
    <Compile Include="CommandExchangeTests.cs" />
    <Compile Include="CommLogTests.cs" />
    <Compile Include="SeriesGrowthTests.cs" />
    <Compile Include="ThresholdSetTests.cs" />
    <Compile Include="EventMarkerTests.cs" />
    <Compile Include="LoaderAckScanTests.cs" />
    <Compile Include="DownloadRunnerTests.cs" />
    <Compile Include="..\Chart\*.cs"
             Exclude="..\Chart\ChartPlotElement.cs" />
    <Compile Include="..\Rtl8239Catalog.cs" />
    <Compile Include="..\Rtl8239Command.cs" />
    <Compile Include="..\Rtl8239DownloadPlan.cs" />
    <Compile Include="..\Rtl8239ResponseParser.cs" />
    <Compile Include="..\ResponseSummarizer.cs" />
    <Compile Include="..\Serial\*.cs"
             Exclude="..\Serial\SystemSerialTransport.cs" />
  </ItemGroup>

</Project>
