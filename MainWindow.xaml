<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:chart="clr-namespace:WpfApp1.Chart"
        mc:Ignorable="d"
        Title="RTL8239 PoE Command Tool" Height="700" Width="1080"
        Icon="POE.ico"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="帮助">
                <MenuItem Header="关于..." Click="About_Click"/>
            </MenuItem>
        </Menu>
        <TabControl Margin="8">
        <!-- ============================================================= -->
        <!-- 页 1：命令组装 -->
        <!-- ============================================================= -->
        <TabItem Header="命令组装">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="命令列表" FontSize="14" FontWeight="Bold"
                                   Margin="10,8,0,6"/>
                        <ListBox x:Name="CommandList"
                                 SelectionChanged="CommandList_SelectionChanged"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="#1A73E8" Margin="2,10,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Key}" Foreground="#888888"
                                                   FontFamily="Consolas" Width="60"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CmdTitle" Grid.Row="0" FontSize="20" FontWeight="Bold"
                               Text="请在左侧选择命令"/>

                    <GroupBox Grid.Row="1" Header="命令介绍" Margin="0,10,0,0" Padding="8">
                        <TextBlock x:Name="DescText" TextWrapping="Wrap" LineHeight="20" Foreground="#333333"/>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="参数" Margin="0,10,0,0" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ParamPanel"/>
                        </ScrollViewer>
                    </GroupBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="序列号" VerticalAlignment="Center"/>
                        <TextBox x:Name="SeqText" Text="01" Width="60" Height="26" Margin="6,0,0,0"
                                 VerticalAlignment="Center" FontFamily="Consolas"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="GenButton" Content="生成命令" Width="110" Height="26"
                                Margin="16,0,0,0" VerticalAlignment="Center" Click="Generate_Click"/>
                    </StackPanel>

                    <GroupBox Grid.Row="4" Header="生成的命令帧（十六进制）" Margin="0,10,0,0" Padding="8">
                        <TextBox x:Name="ResultBox" IsReadOnly="True" FontFamily="Consolas" FontSize="14"
                                 TextWrapping="Wrap" MinHeight="64"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ============================================================= -->
        <!-- 页 2：响应解析 -->
        <!-- ============================================================= -->
        <TabItem Header="响应解析">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" LineHeight="20" Foreground="#555555"
                           Text="粘贴响应帧，点「解析」即可解码为字段与物理量。支持 0x40-0x50 查询命令、0xC0 系子命令、0xF1 寄存器读，以及 0xC0-80~83 / 0xCA 的 4 字节下载应答。字节间用空格 / 逗号 / 换行分隔，十六进制。"/>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="期望序列号（可选）" VerticalAlignment="Center"/>
                    <TextBox x:Name="ExpectSeqText" Width="60" Height="26" Margin="6,0,0,0"
                             VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="期望端口（可选）" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBox x:Name="ExpectPortText" Width="60" Height="26" Margin="6,0,0,0"
                             VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="字节序" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="RespByteOrderCombo" Width="118" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="填写后核对响应帧回显值，不一致只在结果顶部提示，不阻断解析"
                               VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888888"/>
                </WrapPanel>

                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="ParseRespButton" DockPanel.Dock="Right" Content="解析"
                            Width="90" Height="26" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="ParseResponse_Click"/>
                    <TextBox x:Name="RespInput" Height="60" FontFamily="Consolas" FontSize="14"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>

                <GroupBox Grid.Row="3" Header="解析结果" Margin="0,10,0,0" Padding="8">
                    <TextBox x:Name="RespOutput" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </TabItem>

        <!-- ============================================================= -->
        <!-- 页 3：固件下载 -->
        <!-- ============================================================= -->
        <TabItem Header="固件下载">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="下载类型：" VerticalAlignment="Center"/>
                    <RadioButton x:Name="DownloadTypeApp" Content="App 下载 (0xC0-80~83)"
                                 IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <RadioButton x:Name="DownloadTypeFw" Content="Firmware 下载 (0xCA)"
                                 VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="序列号" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <TextBox x:Name="DlSeqText" Text="01" Width="60" Height="26" Margin="6,0,0,0"
                             VerticalAlignment="Center" FontFamily="Consolas"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择固件文件…"
                            Width="120" Height="26" Margin="10,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="FilePathBox" Height="26" VerticalContentAlignment="Center"
                             FontFamily="Consolas" IsReadOnly="True" Text="尚未选择文件"/>
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="GenDlButton" DockPanel.Dock="Right" Content="生成下载帧"
                            Width="130" Height="26" Click="GenDownload_Click"/>
                    <TextBlock x:Name="DlHint" TextWrapping="Wrap" LineHeight="20" Foreground="#555555"
                               VerticalAlignment="Center"
                               Text="按 32 字节分帧，自动计算 64K 块号（SUB）与偏移。App 下载固件需 4 字节对齐。"/>
                </DockPanel>

                <GroupBox Grid.Row="3" Header="下载命令帧" Margin="0,10,0,0" Padding="8">
                    <TextBox x:Name="DlOutput" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </TabItem>
        <!-- ============================================================= -->
        <!-- 页 4：串口读写 -->
        <!-- ============================================================= -->
        <TabItem Header="串口读写">
            <Grid x:Name="SerialTabGrid" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130" MinHeight="70"/>
                </Grid.RowDefinitions>

                <!-- 串口参数 -->
                <!-- 串口参数：所有输入控件统一高 26、标签前距 16、控件前距 6，整行才对得齐 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="串口" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PortCombo" Width="110" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshPortsButton" Content="刷新" Width="56" Height="26" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="RefreshPorts_Click"/>
                    <TextBlock Text="波特率" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="BaudCombo" Width="90" Height="26" IsEditable="True" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="数据位" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="DataBitsCombo" Width="56" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="校验" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="ParityCombo" Width="78" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="停止位" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="StopBitsCombo" Width="60" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="OpenCloseButton" Content="打开串口" Width="96" Height="26" Margin="16,0,0,0"
                            VerticalAlignment="Center" Click="OpenClose_Click"/>
                    <TextBlock x:Name="SerialStatusText" Text="未打开" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="#888888"/>
                </WrapPanel>

                <!-- 发送方式 -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="ModeTextRadio" Content="文本命令模板" IsChecked="True"
                                 VerticalAlignment="Center" Checked="SendMode_Checked"/>
                    <RadioButton x:Name="ModeRawRadio" Content="裸帧直连" VerticalAlignment="Center"
                                 Margin="14,0,0,0" Checked="SendMode_Checked"/>
                    <TextBlock Text="模板" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBox x:Name="TemplateBox" Width="320" Height="26" FontFamily="Consolas"
                             VerticalContentAlignment="Center" Margin="6,0,0,0"
                             Text="uart_test {FRAME} {LEN} 500000"
                             ToolTip="占位符：{FRAME} 展开成十六进制帧，{LEN} 展开成字节数。注意设备提示符（如 debug#）不要写进模板。"/>
                    <TextBlock Text="行结束" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="EndingCombo" Width="72" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="SendOnceButton" Content="发送一次" Width="90" Height="26"
                            Margin="16,0,0,0" VerticalAlignment="Center" Click="SendOnce_Click"/>
                </WrapPanel>

                <!-- 手动帧与识别规则：内容太宽，明确排成两行，别让 WrapPanel 把「字节序」拆散 -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="手动发送帧（十六进制）" VerticalAlignment="Center"/>
                        <TextBox x:Name="ManualFrameBox" Width="320" Height="26" FontFamily="Consolas"
                                 VerticalContentAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text="响应识别规则" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox x:Name="PatternBox" Width="300" Height="26" FontFamily="Consolas"
                                 VerticalContentAlignment="Center" Margin="6,0,0,0" TextChanged="PatternBox_TextChanged"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="字节序" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ByteOrderCombo" Width="118" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"
                                  ToolTip="响应里多字节字段（电压/电流/温度/功率、设备 ID 等）的字节序。真机实测为大端；手册没有明确规定，换设备时若数值明显离谱可切到小端。"/>
                        <CheckBox x:Name="LooseScanCheck" Content="宽松扫描" VerticalAlignment="Center" Margin="16,0,0,0"
                                  ToolTip="识别规则不匹配时，直接取这一行里前 12 个十六进制字节。默认关闭，因为设备回显行里也有帧，容易被误当成响应。"/>
                        <TextBlock x:Name="PatternHint" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888888"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 轮询设置 -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="轮询命令（可多选）" FontWeight="Bold"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,4,0,0" MaxHeight="110">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PollListPanel" Margin="6"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <WrapPanel>
                            <TextBlock Text="间隔(ms)" VerticalAlignment="Center"/>
                            <TextBox x:Name="IntervalBox" Text="1000" Width="56" Height="26" Margin="6,0,0,0"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                            <TextBlock Text="超时(ms)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <TextBox x:Name="TimeoutBox" Text="1500" Width="56" Height="26" Margin="6,0,0,0"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"
                                     ToolTip="单条命令等回包的时长，超了就重试或跳过。设备控制台要先转发再等回包，通常要几百毫秒，所以默认给到 1500。"/>
                            <TextBlock Text="重试次数" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <TextBox x:Name="RetryBox" Text="2" Width="56" Height="26" Margin="6,0,0,0"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                            <TextBlock Text="命令间隔(ms)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <TextBox x:Name="GapBox" Text="500" Width="56" Height="26" Margin="6,0,0,0"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"
                                     ToolTip="同一轮里两条命令之间的最小间隔（设备控制台需要喘息时间）。默认 500ms。"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="StartPollButton" Content="开始轮询" Width="92" Height="26" Click="StartPoll_Click"/>
                            <Button x:Name="StopPollButton" Content="停止" Width="92" Height="26" Margin="10,0,0,0"
                                    IsEnabled="False" Click="StopPoll_Click"/>
                            <TextBlock x:Name="PollStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888888"/>
                        </WrapPanel>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#888888"
                                   Text="端口可填多个（0,1,2 或 0-3），一条命令会展开成多条轮询。提示：0x42「端口状态获取」只有状态，不含电压/电流/功率；要画功率和电流请勾选 0x44（端口测量）或 0x4F（端口双通道电压电流），系统功率用 0x41。"/>
                    </StackPanel>
                </Grid>

                <!-- 曲线 -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="0" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="曲线（勾选显示 · 单击选中 · 双击看详情）" FontWeight="Bold" TextWrapping="Wrap"/>
                        <!-- 列表行用 * 撑满剩余高度：这样 ScrollViewer 才有确定的高度，
                             条目多的时候才会真的出现滚动条 -->
                        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="LegendPanel" Margin="6"/>
                            </ScrollViewer>
                        </Border>

                        <!-- 选中曲线的统计（没选中时不占地方） -->
                        <Border x:Name="SelectionStatsPanel" Grid.Row="2" Background="#F5F5F5"
                                BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,6,0,0" Padding="4"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SelectionStatsText" TextWrapping="Wrap" FontSize="12" Foreground="#333333"/>
                        </Border>

                        <!-- 用 Grid 而不是 WrapPanel：三个控件永远在同一行，不会因为装不下而换行错位 -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="时间窗" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="WindowCombo" MinWidth="56" Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="WindowCombo_SelectionChanged"/>
                            <Button Grid.Column="2" x:Name="MaximizeChartButton" Content="最大化" Width="60" Height="26"
                                    Margin="6,0,0,0" Click="MaximizeChart_Click"
                                    ToolTip="收起上面的配置行和下面的日志，让曲线占满整页（轮询的启停保留）。再点一次还原。"/>
                            <Button Grid.Column="3" x:Name="ClearChartButton" Content="清空" Width="48" Height="26"
                                    Margin="6,0,0,0" Click="ClearChart_Click"
                                    ToolTip="清空所有曲线，重新开始采集"/>
                        </Grid>
                        <WrapPanel Grid.Row="4" Margin="0,6,0,0">
                            <TextBlock Text="纵轴" VerticalAlignment="Center"/>
                            <Button x:Name="ZoomInButton" Content="放大" Width="52" Height="26"
                                    Margin="6,0,0,0" Click="ZoomIn_Click"
                                    ToolTip="把每个子图的纵轴刻度放大（看得清小幅波动）"/>
                            <Button x:Name="ZoomOutButton" Content="缩小" Width="52" Height="26"
                                    Margin="6,0,0,0" Click="ZoomOut_Click"/>
                            <Button x:Name="ZoomAutoButton" Content="自动" Width="52" Height="26"
                                    Margin="6,0,0,0" Click="ZoomAuto_Click"
                                    ToolTip="恢复成按数据范围自动铺满"/>
                            <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888888"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="5" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#888888"
                                   Text="滚轮缩放纵轴；单击图例选中曲线（加粗），双击看详细统计。"/>
                    </Grid>

                    <Border Grid.Column="1" Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="10,0,0,0">
                        <chart:ChartPlotElement x:Name="Plot"/>
                    </Border>

                    <DockPanel Grid.Column="1" Grid.Row="1" Margin="10,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="时间回看" VerticalAlignment="Center"/>
                        <Button x:Name="HistoryLiveButton" DockPanel.Dock="Right" Content="回到最新" Width="80" Height="24"
                                Margin="10,0,0,0" Click="HistoryLive_Click"
                                ToolTip="切回跟随最新数据"/>
                        <TextBlock x:Name="HistoryText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="#888888" MinWidth="56" TextAlignment="Right"/>
                        <Slider x:Name="HistorySlider" Minimum="0" Maximum="30" Value="0"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                ValueChanged="HistorySlider_ValueChanged"
                                ToolTip="往右拖可以回看历史，单位分钟（0 = 跟着最新数据）。回看时画面会钉住不动，方便看清某一段。"/>
                    </DockPanel>
                </Grid>

                <!-- 分隔条：上下拖动可以调整「曲线」与「日志」的高度分配 -->
                <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="#DDDDDD" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                              ToolTip="上下拖动，给曲线图腾地方"/>

                <!-- 日志 -->
                <GroupBox Grid.Row="6" Margin="0,10,0,0" Padding="6"
                          Header="收发日志（[设备] 串口原样输出 · [发送] 工具发出 · [识别] 识别出的帧 · [解析] 解析结果 · [工具] 工具提示）">
                    <TextBox x:Name="SerialLogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </TabItem>
    </TabControl>
    </DockPanel>
</Window>
